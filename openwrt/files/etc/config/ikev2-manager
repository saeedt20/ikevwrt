config globals 'globals'
	option schema_version '1'
	option runtime_schema '2'
	option configured '0'
	option wan_interface 'wan'
	option wan_zone 'wan'
	list source_interface 'lan'
	list source_zone 'lan'
	option dns_enforce '0'
	option block_dot '0'

config client 'client'
	option enabled '0'
	option auth_method 'eap-mschapv2'
	option remote_address ''
	option remote_id ''
	option username ''
	option client_cert ''
	option client_key ''
	option dpd '30'
	option mtu '1400'
	option reconnect_cooldown '15'
	option tunnel_dns_provider 'cloudflare'
	option tunnel_dns_upstream 'https://cloudflare-dns.com/dns-query'
	option tunnel_dns_bootstrap '1.1.1.1:53 1.0.0.1:53'
	option custom_config '0'

config dns 'dns'
	option managed '0'
	option protocol 'doh'
	option provider 'cloudflare'
	option upstream_mode 'load_balance'
	option upstream 'https://dns.cloudflare.com/dns-query'
	option bootstrap '1.1.1.1:53 1.0.0.1:53'
	option fallback ''
	option wan_fallback '0'
	option tunnel_resolve '0'
	option timeout '4s'

config domains 'domains'
	option iran_direct '1'
	option engine 'nftset'
	option fakeip_ttl '60'
	option cache_capacity '8192'
	option cache_path '/etc/ikev2-manager/domain-router-cache.db'
	option log_level 'warn'
	option route_router_traffic '0'
	option paused '0'
