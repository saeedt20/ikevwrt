#!/bin/sh
# SPDX-License-Identifier: MIT
# Copyright (c) 2026 Nikitid

# Sourced by PBR after its WAN user sets have been declared. Input files are
# validated by ikev2-iran-direct before this include is enabled.
[ "$(uci -q get ikev2-manager.domains.iran_direct 2>/dev/null || true)" = 1 ] || return 0
iran_dir="${IKEV2_IRAN_DIR:-/etc/ikev2-manager}"
[ -s "$iran_dir/iran-domains.txt" ] && [ -f "$iran_dir/iran-cidrs.txt" ] || return 1
iran_dnsmasq="${packageDnsmasqFile:-/var/run/pbr.dnsmasq}"

# PBR's user destination sets are tested before ordinary policy sets. Dnsmasq
# inserts resolved A and AAAA addresses as queries arrive.
awk '{ printf "nftset=/%s/4#inet#fw4#pbr_wan_4_dst_ip_user,6#inet#fw4#pbr_wan_6_dst_ip_user\n", $0 }' \
	"$iran_dir/iran-domains.txt" >> "$iran_dnsmasq" || return 1

for iran_family in 4 6; do
	iran_batch=''
	iran_count=0
	while IFS= read -r iran_cidr; do
		case "$iran_family:$iran_cidr" in
			4:*:*) continue ;;
			6:*.*) continue ;;
		esac
		iran_batch="${iran_batch}${iran_batch:+, }$iran_cidr"
		iran_count=$((iran_count + 1))
		if [ "$iran_count" -ge 50 ]; then
			nft add element inet fw4 "pbr_wan_${iran_family}_dst_ip_user" "{ $iran_batch }" || return 1
			iran_batch=''
			iran_count=0
		fi
	done < "$iran_dir/iran-cidrs.txt"
	[ -z "$iran_batch" ] ||
		nft add element inet fw4 "pbr_wan_${iran_family}_dst_ip_user" "{ $iran_batch }" || return 1
done

# Device full-route marks otherwise hit PBR's early return before its WAN sets.
iran_ike_rule="$(ip -4 rule show | awk '
	/lookup pbr_ikev2out([[:space:]]|$)/ {
		for (i=1; i<=NF; i++) if ($i == "fwmark") { print $(i+1); exit }
	}')"
printf '%s\n' "$iran_ike_rule" | grep -Eq '^0x[0-9a-fA-F]+/0x[0-9a-fA-F]+$' || {
	echo 'Iran direct routing cannot determine the outbound VPN mark' >&2
	return 1
}
[ -s "${nftTempFile:-}" ] || return 1
iran_wan_chain="$(awk '
	$1 == "add" && $2 == "rule" && $3 == "inet" && $4 == "fw4" &&
	$5 == "pbr_prerouting" && $6 == "ip" && $7 == "daddr" &&
	$8 == "@pbr_wan_4_dst_ip_user" && $9 == "goto" { print $10; exit }
	' "$nftTempFile")"
printf '%s\n' "$iran_wan_chain" | grep -Eq '^pbr_mark_0x[0-9a-fA-F]+$' || return 1
nft insert rule inet fw4 pbr_prerouting \
	meta mark \& "${iran_ike_rule#*/}" == "${iran_ike_rule%/*}" \
	ip daddr @pbr_wan_4_dst_ip_user counter goto "$iran_wan_chain" \
	comment '"ikev2-iran:priority"' || return 1
return 0
