{
	"luci-app-ikev2-manager": {
		"description": "Manage and monitor the router IKEv2 system",
		"read": {
			"file": {
				"/etc/pbr-ikev2-domains.txt": [ "read" ],
				"/etc/pbr-ikev2-domains.manual.txt": [ "read" ],
				"/etc/pbr-ikev2-addresses.manual.txt": [ "read" ],
				"/etc/pbr-ikev2-community-selected.txt": [ "read" ],
				"/tmp/ikev2-domains-community.status": [ "read" ],
				"/tmp/ikev2-manager-deps.status": [ "read" ],
				"/usr/libexec/ikev2-devices networks": [ "exec" ],
				"/usr/libexec/ikev2-devices clients": [ "exec" ],
				"/usr/libexec/ikev2-devices dump": [ "exec" ],
				"/usr/libexec/ikev2-device-routing stats": [ "exec" ],
				"/usr/libexec/ikev2-domains-community services": [ "exec" ],
				"/usr/libexec/ikev2-domains-community sources": [ "exec" ],
				"/usr/libexec/ikev2-domains-community service-read *": [ "exec" ],
				"/usr/libexec/ikev2-domains-community status *": [ "exec" ],
				"/usr/libexec/ikev2-domain-router status": [ "exec" ],
				"/usr/libexec/ikev2-iran-direct status": [ "exec" ],
				"/usr/libexec/ikev2-iran-direct read": [ "exec" ],
				"/usr/libexec/ikev2-manager widget-status": [ "exec" ],
				"/usr/libexec/ikev2-manager client-get": [ "exec" ],
				"/usr/libexec/ikev2-manager action-status *": [ "exec" ],
				"/usr/libexec/ikev2-manager advanced-mode outbound": [ "exec" ],
				"/usr/libexec/ikev2-manager advanced-read outbound": [ "exec" ],
				"/usr/libexec/ikev2-manager-system get": [ "exec" ],
				"/usr/libexec/ikev2-manager-system dns-get": [ "exec" ],
				"/usr/libexec/ikev2-manager-system dns-segments-get": [ "exec" ],
				"/usr/libexec/ikev2-manager-system doctor-ui": [ "exec" ],
				"/usr/libexec/ikev2-manager-system action-status *": [ "exec" ],
				"/usr/sbin/swanmon list-sas": [ "exec" ]
			},
			"ubus": {
				"file": [
					"exec",
					"read",
					"stat"
				]
			}
		},
		"write": {
			"file": {
				"/tmp/ikev2-domains-input-*.domains": [ "write" ],
				"/tmp/ikev2-domains-input-*.cidrs": [ "write" ],
				"/tmp/ikev2-domains-input-*.services": [ "write" ],
				"/tmp/ikev2-service-input-*.meta": [ "write" ],
				"/tmp/ikev2-service-input-*.domains": [ "write" ],
				"/tmp/ikev2-service-input-*.cidrs": [ "write" ],
				"/var/run/ikev2-manager-client-*.in": [ "write" ],
				"/var/run/ikev2-manager-material-*.in": [ "write" ],
				"/var/run/ikev2-manager-profile-*.in": [ "write" ],
				"/tmp/run/ikev2-manager-client-*.in": [ "write" ],
				"/tmp/run/ikev2-manager-material-*.in": [ "write" ],
				"/tmp/run/ikev2-manager-profile-*.in": [ "write" ],
				"/usr/libexec/ikev2-manager client-input *": [ "exec" ],
				"/usr/libexec/ikev2-manager client-material-import *": [ "exec" ],
				"/tmp/ikev2-manager-dns-*.in": [ "write" ],
				"/tmp/ikev2-manager-dns-segment-*.in": [ "write" ],
				"/usr/libexec/ikev2-manager reconnect-client": [ "exec" ],
				"/usr/libexec/ikev2-manager advanced-start outbound *": [ "exec" ],
				"/usr/libexec/ikev2-manager advanced-reset-start outbound": [ "exec" ],
				"/usr/libexec/ikev2-manager-system install-deps": [ "exec" ],
				"/usr/libexec/ikev2-manager-system remove-deps": [ "exec" ],
				"/usr/libexec/ikev2-manager-system set-async *": [ "exec" ],
				"/usr/libexec/ikev2-manager-system device-async set-exclusions *": [ "exec" ],
				"/usr/libexec/ikev2-manager-system device-async set-included *": [ "exec" ],
				"/usr/libexec/ikev2-manager-system device-async clear-policy *": [ "exec" ],
				"/usr/libexec/ikev2-manager-system dns-set-async *": [ "exec" ],
				"/usr/libexec/ikev2-manager-system routing-pause-async": [ "exec" ],
				"/usr/libexec/ikev2-manager-system routing-resume-async": [ "exec" ],
				"/usr/libexec/ikev2-manager-system dns-segment-input *": [ "exec" ],
				"/usr/libexec/ikev2-domains-community schedule *": [ "exec" ],
				"/usr/libexec/ikev2-domains-community service-schedule *": [ "exec" ],
				"/usr/libexec/ikev2-domain-router activate-async": [ "exec" ],
				"/usr/libexec/ikev2-domain-router deactivate-async": [ "exec" ],
				"/usr/libexec/ikev2-domain-router router-traffic *": [ "exec" ],
				"/usr/libexec/ikev2-domain-router tunnel-resolve *": [ "exec" ],
				"/usr/libexec/ikev2-domain-router log-level *": [ "exec" ],
				"/usr/libexec/ikev2-domain-router diagnostic-start *": [ "exec" ],
				"/usr/libexec/ikev2-iran-direct enable-async": [ "exec" ],
				"/usr/libexec/ikev2-iran-direct disable-async": [ "exec" ],
				"/tmp/ikev2-iran-input-*": [ "write" ],
				"/usr/libexec/ikev2-iran-direct write *": [ "exec" ]
			},
			"ubus": {
				"file": [
					"exec",
					"write"
				]
			}
		}
	}
}
