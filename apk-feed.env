# Public OpenWrt 25.12 build and feed identity. This file is sourced as POSIX sh.

# Target this package is built for.
OPENWRT_APK_VERSION=25.12.6
OPENWRT_APK_TARGET=mediatek/mt7622
OPENWRT_APK_ARCH=aarch64_cortex-a53
OPENWRT_APK_SDK_ARCHIVE=openwrt-sdk-25.12.6-mediatek-mt7622_gcc-14.3.0_musl.Linux-x86_64.tar.zst
OPENWRT_APK_SDK_SHA256=1b8dd1f1a8de9820fc6ed859cb1032904afcc8d1e25f5e4ed85fc41ed755e021

# Dedicated IkevWrt APK signing key. Only the public key is tracked.
OPENWRT_APK_KEY_FILE=keys/ikevwrt-release.pem
OPENWRT_APK_TRUST_SHA256=67d9a98b2527c24269ed688183af18ae2fb8f560292a237822d0cd69e53d24c3

# Inherited feed values remain for separately installed upstream applications.
OPENWRT_FEED_REPOSITORY=Nikitid/openwrt-feed
OPENWRT_FEED_BASE=https://raw.githubusercontent.com/Nikitid/openwrt-feed/feed
OPENWRT_FEED_URL=$OPENWRT_FEED_BASE/packages.adb
OPENWRT_FEED_LIST=/etc/apk/repositories.d/nikitid-openwrt.list
OPENWRT_IKEV2_PACKAGE=luci-app-ikev2-manager
